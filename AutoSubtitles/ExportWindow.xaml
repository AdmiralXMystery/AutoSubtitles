<Window x:Class="AutoSubtitles.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoSubtitles"
        mc:Ignorable="d" WindowStartupLocation="CenterOwner"
        Title="ExportWindow" Height="650" Width="1000" Background="#1E1E1E">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="2" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ ПАНЕЛЬ: НАСТРОЙКИ -->
        <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="File format:" FontWeight="Bold" Margin="0,0,0,5" Foreground="White"/>
            <ComboBox x:Name="FormatComboBox" 
                          SelectionChanged="OnSettingsChanged"
                          Margin="0,0,0,15" 
                          Foreground="White">
                <ComboBoxItem Content="Text document (*.txt)" IsSelected="True"/>
                <ComboBoxItem Content="Format JSON (*.json)"/>
            </ComboBox>

            <TextBlock Text="Include in export:" FontWeight="Bold" Margin="0,0,0,5" Foreground="White"/>
            <!-- Все чекбоксы подписаны на одно событие для обновления предпросмотра -->
            <CheckBox x:Name="IncludeTimestampsCheckBox" Content="Timestamps (00:00:00)" IsChecked="True" Checked="OnSettingsChanged" Unchecked="OnSettingsChanged" Margin="0,0,0,8" Foreground="White"/>
            <CheckBox x:Name="IncludeSpeakerCheckBox" Content="Speaker names" IsChecked="True" Checked="OnSettingsChanged" Unchecked="OnSettingsChanged" Margin="0,0,0,8" Foreground="White"/>
            <CheckBox x:Name="IncludeTextCheckBox" Content="Text of the remark" IsChecked="True" Checked="OnSettingsChanged" Unchecked="OnSettingsChanged" IsEnabled="False" Margin="0,0,0,15" Foreground="White"/>

            <StackPanel x:Name="RenameSpeakersPanel" Margin="0,0,0,15">
                <TextBlock Text="Rename speakers:" FontWeight="Bold"
               Margin="0,0,0,5" Foreground="White"/>
                <TextBlock Text="Leave a field empty to keep the original name."
               Foreground="#888" FontSize="11" Margin="0,0,0,5" TextWrapping="Wrap"/>
                <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="SpeakerRenameList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="80"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                   Text="{Binding Original}"
                                   Foreground="#BBB"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="→" Foreground="#888"
                                   Margin="6,0" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2"
                                 Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="OnSpeakerRenameChanged"
                                 Background="#2D2D2D" Foreground="White"
                                 BorderBrush="#555" Padding="3,1"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
            
            <TextBlock Text="Separator for TXT:" FontWeight="Bold" Margin="0,0,0,5" Foreground="White"/>
            <ComboBox x:Name="SeparatorComboBox" 
                      SelectionChanged="OnSettingsChanged"
                      Margin="0,0,0,20" 
                      Foreground="White">
                <ComboBox.Style>
                    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                        <Style.Triggers>
                            <!-- Если в FormatComboBox выбран 1-й индекс (JSON), отключаем этот список -->
                            <DataTrigger Binding="{Binding ElementName=FormatComboBox, Path=SelectedIndex}" Value="1">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.Style>
                <ComboBoxItem Content="New Row" IsSelected="True"/>
                <ComboBoxItem Content="Tab"/>
                <ComboBoxItem Content="Space"/>
            </ComboBox>

            <!-- Кнопки управления внизу левой панели -->
            <Grid VerticalAlignment="Bottom" Margin="0,30,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Content="Save..." Grid.Column="0" Click="SaveButton_Click" Height="30" Margin="0,0,5,0" FontWeight="Bold"/>
                <Button Content="Cancel" Grid.Column="1" Click="CancelButton_Click" Height="30" Margin="5,0,0,0"/>
            </Grid>
        </StackPanel>

        <!-- РАЗДЕЛИТЕЛЬ -->
        <GridSplitter Grid.Column="1" Width="2" HorizontalAlignment="Stretch" Background="#CCCCCC"/>

        <!-- ПРАВАЯ ПАНЕЛЬ: ПРЕДПРОСМОТР -->
        <DockPanel Grid.Column="2" Margin="10,0,0,0">
            <TextBlock Text="Output structure preview:" Foreground="White" DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="PreviewTextBox"  IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#1E1E1E" FontFamily="Consolas" Foreground="White"/>
        </DockPanel>
    </Grid>
</Window>